{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "NUXT_APP_BASE_URL=/ NUXT_PUBLIC_API_BASE=/api NITRO_PRESET=static npm --prefix frontend run generate",
  "outputDirectory": "frontend/.output/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://159.194.208.66:8000/api/:path*"
    }
  ]
}
